{
  "name": "BFIA协议",
  "desc": "北京金融科技产业联盟（Beijing FinTech Industry Alliance）主导的《隐私计算 跨平台互联互通 开放协议》簇及实现",
  "version": "0.0.1",
  "comps": [
    {
      "domain": "隐私求交",
      "name": "ecdh-psi",
      "desc": "ECDH-PSI算法插件使用基于椭圆曲线迪菲-赫尔曼（ECDH）的隐私集合求交算法，为双方提供简单、高效、安全的求交策略 - 算法协议详细信息请参阅《隐私计算 跨平台互联互通 开放协议 第 1 部分： ECDH-PSI》",
      "version": "0.0.1",
      "attrs": [
      ],
      "inputs": [
        {
          "name": "receiver_input",
          "desc": "Individual table for receiver",
          "types": [
            "sf.table.individual"
          ],
          "attrs": [
            {
              "name": "key",
              "desc": "Column(s) used to join.",
              "colMinCntInclusive": "1"
            }
          ]
        },
        {
          "name": "sender_input",
          "desc": "Individual table for sender",
          "types": [
            "sf.table.individual"
          ],
          "attrs": [
            {
              "name": "key",
              "desc": "Column(s) used to join.",
              "colMinCntInclusive": "1"
            }
          ]
        }
      ],
      "outputs": [
        {
          "name": "psi_output",
          "desc": "Output vertical table",
          "types": [
            "sf.table.vertical_table"
          ]
        }
      ]
    },
    {
      "domain": "输入输出",
      "name": "read_data",
      "desc": "用于输入表（组件）非协议簇",
      "version": "0.0.1",
      "inputs": [
        {
          "name": "input_dd",
          "desc": "Input dist data",
          "types": [
            "sf.rule.binning",
            "sf.model.ss_glm"
          ]
        }
      ],
      "outputs": [
        {
          "name": "output_data",
          "desc": "Output rules or models in DistData.meta",
          "types": [
            "sf.read_data"
          ]
        }
      ]
    },
    {
      "domain": "联邦学习",
      "name": "secureboot",
      "desc": "SecureBoost算法插件使用基于同态加密的两方纵向联邦XGBoost模型，更专注与保护标签持有者 - 算法协议详细信息请参阅《隐私计算 跨平台互联互通 开放协议 第 4 部分： SecureBoost》",
      "version": "0.0.1",
      "attrs": [
      ],
      "inputs": [
        {
          "name": "train_dataset",
          "desc": "Input vertical table.",
          "types": [
            "sf.table.vertical_table"
          ],
          "attrs": [
            {
              "name": "feature_selects",
              "desc": "which features should be used for training.",
              "colMinCntInclusive": "1"
            },
            {
              "name": "label",
              "desc": "Label of train dataset.",
              "colMinCntInclusive": "1",
              "colMaxCntInclusive": "1"
            }
          ]
        }
      ],
      "outputs": [
        {
          "name": "sgb_output",
          "desc": "Output vertical table",
          "types": [
            "sf.table.vertical_table"
          ]
        },
        {
          "name": "output_zip",
          "desc": "Output zip.",
          "types": [
            "sf.zip.sgb"
          ]
        }
      ]
    },
    {
      "domain": "联邦学习",
      "name": "ss-lr",
      "desc": "SS-LR算法插件使用基于Semi2K协议的两方秘密分享的纵向联邦逻辑回归 - 算法协议详细信息请参阅《隐私计算 跨平台互联互通 开放协议 第 2 部分： SS-LR》",
      "version": "0.0.1",
      "attrs": [
      ],
      "inputs": [
        {
          "name": "train_dataset",
          "desc": "Input vertical table.",
          "types": [
            "sf.table.vertical_table"
          ],
          "attrs": [
            {
              "name": "feature_selects",
              "desc": "which features should be used for training.",
              "colMinCntInclusive": "1"
            },
            {
              "name": "label",
              "desc": "Label of train dataset.",
              "colMinCntInclusive": "1",
              "colMaxCntInclusive": "1"
            }
          ]
        }
      ],
      "outputs": [
        {
          "name": "ss_lr_output",
          "desc": "Output vertical table",
          "types": [
            "sf.table.vertical_table"
          ]
        }
      ]
    }
  ]
}
