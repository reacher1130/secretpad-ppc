{
  "name": "BFIA协议",
  "desc": "北京金融科技产业联盟（Beijing FinTech Industry Alliance）主导的《隐私计算 跨平台互联互通 开放协议》簇及实现",
  "version": "0.0.1",
  "comps": [
    {
      "domain": "隐私求交",
      "name": "ecdh-psi",
      "desc": "ECDH-PSI算法插件使用基于椭圆曲线迪菲-赫尔曼（ECDH）的隐私集合求交算法，为双方提供简单、高效、安全的求交策略 - 算法协议详细信息请参阅《隐私计算 跨平台互联互通 开放协议 第 1 部分： ECDH-PSI》",
      "version": "0.0.1",
      "attrs": [
      ],
      "inputs": [
        {
          "name": "receiver_input",
          "desc": "Individual table for receiver",
          "types": [
            "sf.table.individual"
          ],
          "attrs": [
            {
              "name": "key",
              "desc": "Column(s) used to join.",
              "col_min_cnt_inclusive": 1
            }
          ]
        },
        {
          "name": "sender_input",
          "desc": "Individual table for sender",
          "types": [
            "sf.table.individual"
          ],
          "attrs": [
            {
              "name": "key",
              "desc": "Column(s) used to join.",
              "col_min_cnt_inclusive": 1
            }
          ]
        }
      ],
      "outputs": [
        {
          "name": "psi_output",
          "desc": "Output vertical table",
          "types": [
            "sf.table.vertical_table"
          ]
        }
      ]
    },
    {
      "domain": "read_data",
      "name": "datatable",
      "desc": "选择 BFIA 项目参与节点的数据表。该节点只描述输入数据，不会被提交为计算算子。",
      "version": "0.0.1",
      "attrs": [
        {
          "name": "datatable_selected",
          "desc": "BFIA 数据表",
          "type": "AT_STRING",
          "atomic": {
            "is_optional": false
          }
        }
      ],
      "inputs": [
      ],
      "outputs": [
        {
          "name": "output_data",
          "desc": "Output rules or models in DistData.meta",
          "types": [
            "sf.table.individual"
          ]
        }
      ]
    },
    {
      "domain": "联邦学习",
      "name": "secureboot",
      "desc": "SecureBoost算法插件使用基于同态加密的两方纵向联邦XGBoost模型，更专注与保护标签持有者 - 算法协议详细信息请参阅《隐私计算 跨平台互联互通 开放协议 第 4 部分： SecureBoost》",
      "version": "0.0.1",
      "attrs": [
      ],
      "inputs": [
        {
          "name": "host_dataset",
          "desc": "Host input table, or an upstream BFIA task output.",
          "types": [
            "sf.table.individual",
            "sf.table.vertical_table"
          ],
          "attrs": [
            {
              "name": "feature_selects",
              "desc": "which features should be used for training.",
              "col_min_cnt_inclusive": 1
            },
            {
              "name": "label",
              "desc": "Label of train dataset.",
              "col_min_cnt_inclusive": 1,
              "col_max_cnt_inclusive": 1
            }
          ]
        },
        {
          "name": "guest_dataset",
          "desc": "Guest input table. It is optional when host_dataset is an upstream BFIA task output.",
          "types": [
            "sf.table.individual",
            "sf.table.vertical_table"
          ]
        }
      ],
      "outputs": [
        {
          "name": "sgb_output",
          "desc": "Output vertical table",
          "types": [
            "sf.table.vertical_table"
          ]
        }
      ]
    },
    {
      "domain": "联邦学习",
      "name": "ss-lr",
      "desc": "SS-LR算法插件使用基于Semi2K协议的两方秘密分享的纵向联邦逻辑回归 - 算法协议详细信息请参阅《隐私计算 跨平台互联互通 开放协议 第 2 部分： SS-LR》",
      "version": "0.0.1",
      "attrs": [
      ],
      "inputs": [
        {
          "name": "host_dataset",
          "desc": "Host input table, or an upstream BFIA task output.",
          "types": [
            "sf.table.individual",
            "sf.table.vertical_table"
          ],
          "attrs": [
            {
              "name": "feature_selects",
              "desc": "which features should be used for training.",
              "col_min_cnt_inclusive": 1
            },
            {
              "name": "label",
              "desc": "Label of train dataset.",
              "col_min_cnt_inclusive": 1,
              "col_max_cnt_inclusive": 1
            }
          ]
        },
        {
          "name": "guest_dataset",
          "desc": "Guest input table. It is optional when host_dataset is an upstream BFIA task output.",
          "types": [
            "sf.table.individual",
            "sf.table.vertical_table"
          ]
        }
      ],
      "outputs": [
        {
          "name": "ss_lr_output",
          "desc": "Output vertical table",
          "types": [
            "sf.table.vertical_table"
          ]
        }
      ]
    }
  ]
}
